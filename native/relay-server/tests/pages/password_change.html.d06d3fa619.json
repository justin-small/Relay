 "html": "<!doctype html>\n<html lang=\"en\"><head>\n<title>Change your password</title><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<meta name=\"robots\" content=\"noindex\">\n<link rel=\"icon\" href=\"/static/brand/favicon.ico\" sizes=\"32x32\"><link rel=\"icon\" href=\"/static/brand/favicon.svg\" type=\"image/svg+xml\"><link rel=\"apple-touch-icon\" href=\"/static/brand/apple-touch-icon.png\"><link rel=\"manifest\" href=\"/static/brand/site.webmanifest\"><link rel=\"stylesheet\" href=\"/static/viewer.css?v=18eabefb1d726926\"><link rel=\"stylesheet\" href=\"/static/tokens.css?v=18eabefb1d3bf1bf\"><link rel=\"stylesheet\" href=\"/static/components.css?v=18eabefb212bd886\"><link rel=\"stylesheet\" href=\"/static/standalone.css?v=18eabefb1d26673f\">\n<script src=\"/static/look.js?v=18eabefb21aa1849\"></script>\n</head><body>\n<form method=\"post\" action=\"/admin/password\">\n  <img class=\"mark\" src=\"/static/brand/relay-mark.svg\" width=\"52\" height=\"52\" alt=\"Relay\">\n  <h1>Change your password</h1>\n  \n  <p class=\"sub\">Choose a new password. You stay signed in here; your other sign-ins end.</p>\n  <input type=\"hidden\" name=\"voluntary\" value=\"1\">\n  \n  <label for=\"current\">Current password</label>\n  <input id=\"current\" type=\"password\" name=\"current\" autocomplete=\"current-password\" autofocus required>\n  <label for=\"new\">New password</label>\n  <input id=\"new\" type=\"password\" name=\"new\" autocomplete=\"new-password\" minlength=\"8\" required>\n  <label for=\"confirm\">Confirm new password</label>\n  <input id=\"confirm\" type=\"password\" name=\"confirm\" autocomplete=\"new-password\" minlength=\"8\" required>\n  <button class=\"primary\" type=\"submit\">Change password</button>\n  <div class=\"err\" role=\"alert\">That is not the same twice.</div>\n</form>\n\n<form><a class=\"link\" href=\"/home\">Back</a></form>\n\n</body></html>"
}