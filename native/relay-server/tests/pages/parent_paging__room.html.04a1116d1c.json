{
 "template": "parent_paging/room.html",
 "uses": [
  "parent_paging/room.html"
 ],
 "context": {
  "room": {
   "id": "1c28a47c",
   "name": "Room 3",
   "location_id": "301",
   "event": "Sunday Kids"
  }
 },
 "html": "<!doctype html>\n\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<meta name=\"robots\" content=\"noindex\">\n<meta name=\"referrer\" content=\"no-referrer\">\n<title>Page a parent · Room 3</title>\n<style>\n  :root { --bg:#f6f6f4; --card:#fff; --ink:#1b1b1b; --soft:#666; --line:#e2e2de; --accent:#1f6feb; --warn:#b45309;\n          --ok:#15803d; --btn:#eef2f8; }\n  @media (prefers-color-scheme: dark) {\n    :root { --bg:#141414; --card:#1f1f1f; --ink:#f1f1f1; --soft:#a3a3a3; --line:#333; --accent:#5b9bff;\n            --warn:#f59e0b; --ok:#4ade80; --btn:#2a2f38; }\n  }\n  * { box-sizing:border-box; }\n  html, body { margin:0; background:var(--bg); color:var(--ink);\n               font:16px/1.4 system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif; }\n  main { max-width:640px; margin:0 auto; padding:16px 16px 48px; }\n  h1 { font-size:1.4em; margin:4px 0 2px; }\n  .sub { color:var(--soft); margin:0 0 16px; }\n  h2 { font-size:1em; text-transform:uppercase; letter-spacing:.06em; color:var(--soft); margin:24px 0 8px; }\n  .list { background:var(--card); border:1px solid var(--line); border-radius:12px; overflow:hidden; }\n  .kid, .page { display:flex; align-items:center; gap:12px; padding:12px 14px; border-top:1px solid var(--line); }\n  .kid:first-child, .page:first-child { border-top:0; }\n  .name { flex:1; min-width:0; font-size:1.1em; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }\n  .code { font-weight:700; letter-spacing:.08em; font-variant-numeric:tabular-nums; }\n  .page .code { font-size:1.5em; min-width:4.5em; }\n  .state { flex:1; color:var(--soft); }\n  .state.on { color:var(--ok); } .state.wait { color:var(--warn); }\n  button { font:inherit; border:0; border-radius:10px; padding:10px 14px; min-height:44px; cursor:pointer;\n           background:var(--btn); color:var(--ink); }\n  button.go { background:var(--accent); color:#fff; font-weight:600; }\n  button:disabled { opacity:.5; cursor:default; }\n  .paged { color:var(--ok); font-weight:600; }\n  .empty { padding:16px 14px; color:var(--soft); }\n  .note { color:var(--warn); margin:8px 0; }\n  input[type=search] { width:100%; font:inherit; padding:10px 12px; border-radius:10px; border:1px solid var(--line);\n                       background:var(--card); color:var(--ink); margin-bottom:8px; }\n</style>\n</head>\n<body>\n<main>\n  <h1 id=\"room\">Room 3</h1>\n  <p class=\"sub\">Tap a child to page their parent. The screen shows only the code on their label.</p>\n  <p class=\"note\" id=\"note\" hidden></p>\n\n  <section id=\"upBox\" hidden>\n    <h2>Paged now</h2>\n    <div class=\"list\" id=\"pages\"></div>\n  </section>\n\n  <h2>Checked in</h2>\n  <input type=\"search\" id=\"find\" placeholder=\"Find a name or code\" autocomplete=\"off\" hidden>\n  <div class=\"list\" id=\"kids\"><div class=\"empty\">Loading…</div></div>\n</main>\n<script>\n(function () {\n  var base = location.pathname.replace(/\\/+$/, '');\n  var STATE = { waiting: ['Waiting for the booth', 'wait'], shown: ['On screen', 'on'],\n                sent: ['Sent to ProPresenter', 'on'] };\n  var data = null, confirmId = '';\n\n  function el(tag, cls, text) {\n    var n = document.createElement(tag);\n    if (cls) n.className = cls;\n    if (text !== undefined) n.textContent = text;\n    return n;\n  }\n  function note(text) { var n = document.getElementById('note'); n.textContent = text || ''; n.hidden = !text; }\n\n  function call(path, body) {\n    return fetch(base + path, { method: body === undefined ? 'GET' : 'POST', cache: 'no-store',\n      headers: { 'Content-Type': 'application/json' }, body: body === undefined ? undefined : JSON.stringify(body) })\n      .then(function (r) {\n        return r.json().catch(function () { return {}; }).then(function (b) {\n          if (r.status === 404 && body === undefined) { location.reload(); }\n          if (!r.ok) throw new Error(b.error || 'That did not work. Try again.');\n          return b;\n        });\n      });\n  }\n\n  function render() {\n    if (!data) return;\n    var pages = document.getElementById('pages');\n    pages.textContent = '';\n    data.pages.forEach(function (p) {\n      var row = el('div', 'page');\n      var st = STATE[p.status] || STATE.waiting;\n      row.append(el('span', 'code', p.code), el('span', 'state ' + st[1], st[0]));\n      var b = el('button', '', 'Parent arrived');\n      b.onclick = function () {\n        b.disabled = true;\n        call('/arrived/' + p.id, {}).then(refresh, function (e) { note(e.message); b.disabled = false; });\n      };\n      row.appendChild(b);\n      pages.appendChild(row);\n    });\n    document.getElementById('upBox').hidden = !data.pages.length;\n\n    var kids = document.getElementById('kids');\n    var q = (document.getElementById('find').value || '').trim().toLowerCase();\n    document.getElementById('find').hidden = data.kids.length < 12;\n    kids.textContent = '';\n    var shown = data.kids.filter(function (k) {\n      return !q || k.name.toLowerCase().indexOf(q) !== -1 || k.code.toLowerCase().indexOf(q) !== -1;\n    });\n    if (!shown.length) kids.appendChild(el('div', 'empty', data.kids.length ? 'Nobody matches.' :\n      'Nobody is checked in to this room right now.'));\n    shown.forEach(function (k) {\n      var row = el('div', 'kid');\n      row.append(el('span', 'name', k.name), el('span', 'code', k.code));\n      if (k.page) {\n        row.appendChild(el('span', 'paged', 'Paged'));\n      } else if (confirmId === k.id) {\n        var yes = el('button', 'go', 'Page ' + k.code);\n        var no = el('button', '', 'Cancel');\n        yes.onclick = function () {\n          yes.disabled = no.disabled = true;\n          call('/page', { kid: k.id }).then(function () { confirmId = ''; refresh(); },\n            function (e) { note(e.message); confirmId = ''; render(); });\n        };\n        no.onclick = function () { confirmId = ''; render(); };\n        row.append(no, yes);\n      } else {\n        var b = el('button', '', 'Page parent');\n        b.onclick = function () { confirmId = k.id; note(''); render(); };\n        row.appendChild(b);\n      }\n      kids.appendChild(row);\n    });\n  }\n\n  function refresh() {\n    return call('/state').then(function (d) {\n      data = d;\n      document.getElementById('room').textContent = d.room;\n      if (d.note) note(d.note);\n      render();\n    }, function (e) { note(e.message); });\n  }\n\n  document.getElementById('find').addEventListener('input', render);\n  refresh();\n  setInterval(function () { if (!document.hidden && !confirmId) refresh(); }, 10000);\n  document.addEventListener('visibilitychange', function () { if (!document.hidden) refresh(); });\n})();\n</script>\n</body>\n</html>"
}