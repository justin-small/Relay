 "html": "<!doctype html>\n<html lang=\"en\"><head>\n<meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1,viewport-fit=cover\">\n<meta name=\"theme-color\" content=\"#000000\">\n<title>Captions</title>\n<link rel=\"icon\" href=\"/static/brand/favicon.ico\" sizes=\"32x32\"><link rel=\"icon\" href=\"/static/brand/favicon.svg\" type=\"image/svg+xml\"><link rel=\"apple-touch-icon\" href=\"/static/brand/apple-touch-icon.png\"><link rel=\"manifest\" href=\"/static/brand/site.webmanifest\">\n<link rel=\"stylesheet\" href=\"/static/viewer.css?v=18eabefb1d726926\">\n<link rel=\"stylesheet\" href=\"/static/overlay-fonts.css?v=18eabefb21d6b4bc\"><style>\n  /* Broadcast overlay tokens, resolved server-side (app/overlays.py: every value\n     is an enum, a clamped number or a checked colour). The page is a fixed\n     canvas scaled to fit the browser source; everything outside it stays\n     transparent so OBS/ProPresenter composites the alpha directly. */\n  :root {\n    --ov-w: 1920px; --ov-h: 1080px;\n    --ov-font: 54px;\n    --ov-pad-x: 96px; --ov-pad-y: 54px;\n    --ov-plate: 0.55;\n    --ov-platec: 0,0,0;\n    --ov-color: #FFFFFF;\n    --ov-maxw: 88%;\n    --ov-bg: transparent;\n    --ov-hold-ms: 4000ms;\n  }\n</style>\n</head><body class=\" overlay ov-hidden ov-pos-bottom ov-align-center ov-font-sans ov-edge-plate ov-rollup\">\n\n<div class=\"bar\">\n  <span class=\"dot\" id=\"statusDot\"></span>\n  <a href=\"/transcription\" class=\"\">English</a>\n  <a href=\"/translation\" class=\"\">Translation</a>\n  <a href=\"/both\" class=\"on\">Both</a>\n  <span class=\"spacer\"></span>\n  \n  <select id=\"langPicker\" aria-label=\"Translation language\"></select>\n  \n  <button id=\"themeToggle\" aria-label=\"Toggle light or dark theme\" title=\"Light / dark\">&#9681;</button>\n  <button id=\"wakeToggle\" aria-pressed=\"false\" aria-label=\"Keep screen awake\" title=\"Keep screen awake\" hidden>&#9788;</button>\n  <button id=\"presentBtn\" aria-label=\"Presentation mode\" title=\"Presentation mode\">&#9974;</button>\n  <button data-font=\"down\" aria-label=\"Smaller text\">A&minus;</button>\n  <button data-font=\"up\" aria-label=\"Larger text\">A+</button>\n</div>\n\n\n<div class=\"panes ov-canvas\">\n  \n  <div class=\"pane\">\n    \n    <div class=\"feed\" data-stream=\"translation\" data-lang=\"SPANISH\" lang=\"es\" data-lines=\"2\">\n      <div class=\"log\" role=\"log\" aria-live=\"polite\" aria-atomic=\"false\" aria-label=\"Español\"></div>\n    </div>\n  </div>\n  \n  <div class=\"pane\">\n    \n    <div class=\"feed\" data-stream=\"transcription\" data-lang=\"ENGLISH\" lang=\"en\" data-lines=\"2\">\n      <div class=\"log\" role=\"log\" aria-live=\"polite\" aria-atomic=\"false\" aria-label=\"English\"></div>\n    </div>\n  </div>\n  \n</div>\n\n\n\n\n<button id=\"presentExit\" type=\"button\" hidden aria-label=\"Exit presentation mode\">&#10005;</button>\n\n\n\n\n\n<div class=\"toast\" id=\"toast\"></div>\n<script>window.RELAY = {fontPx: 40, sourceLanguage: \"ENGLISH\", sourceIso: \"en\", mode: \"both\", present: false, screen: false, screenLang: \"\", screenFont: 0, overlay: true, overlayLang: \"SPANISH\", overlayW: 1920, overlayH: 1080, overlayFont: 54, overlayHold: 4000, overlayPopOn: false, overlayDemo: null};</script>\n<script src=\"/static/viewer.js?v=18eabefb1d77776d\"></script>\n\n\n</body></html>"
