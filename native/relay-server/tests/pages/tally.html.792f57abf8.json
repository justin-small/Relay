 "html": "<!doctype html>\n<html lang=\"en\"><head>\n<meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1,viewport-fit=cover\">\n<meta name=\"theme-color\" content=\"#000000\">\n<title>Relay tally</title>\n<link rel=\"icon\" href=\"/static/brand/favicon.ico\" sizes=\"32x32\"><link rel=\"icon\" href=\"/static/brand/favicon.svg\" type=\"image/svg+xml\"><link rel=\"apple-touch-icon\" href=\"/static/brand/apple-touch-icon.png\"><link rel=\"manifest\" href=\"/static/brand/site.webmanifest\">\n<link rel=\"stylesheet\" href=\"/static/viewer.css?v=18eabefb1d726926\"><link rel=\"stylesheet\" href=\"/static/tokens.css?v=18eabefb1d3bf1bf\"><script src=\"/static/look.js?v=18eabefb21aa1849\"></script>\n</head><body class=\"tally-page tally-operator\" data-view=\"operator\" data-camera=\"3\">\n\n\n<main class=\"ty-op\" id=\"op\" aria-live=\"polite\">\n  <section class=\"ty-op-main\" id=\"opMain\">\n    <div class=\"ty-num\" id=\"opNum\">3</div>\n    <div class=\"ty-name\" id=\"opName\"></div>\n    <div class=\"ty-state\" id=\"opState\">Connecting…</div>\n    <video class=\"ty-video\" id=\"opVideo\" autoplay muted playsinline hidden></video>\n    <label class=\"ty-pick\" id=\"opPick\" hidden>USB camera <select id=\"opSel\"></select></label>\n  </section>\n  <section class=\"ty-op-bar\">\n    <div class=\"ty-slot\" id=\"opLive\"><span>Live</span><strong>—</strong></div>\n    <div class=\"ty-slot\" id=\"opNext\"><span>Next</span><strong>—</strong></div>\n  </section>\n</main>\n\n\n<script src=\"/static/tally.js?v=18eabefb1d3694dc\"></script>\n</body></html>"
