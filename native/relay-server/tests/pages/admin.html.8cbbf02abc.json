 "html": "<!doctype html>\n\n<html lang=\"en\" data-theme=\"dark\" data-mode=\"dark\" data-preset=\"relay\" data-sb=\"inset\" data-collapse=\"icon\" data-layout=\"centered\" data-navbar=\"sticky\" data-font=\"system\"><head>\n<meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<title>Relay &middot; Operator</title><link rel=\"icon\" href=\"/static/brand/favicon.ico\" sizes=\"32x32\"><link rel=\"icon\" href=\"/static/brand/favicon.svg\" type=\"image/svg+xml\"><link rel=\"apple-touch-icon\" href=\"/static/brand/apple-touch-icon.png\"><link rel=\"manifest\" href=\"/static/brand/site.webmanifest\"><link rel=\"stylesheet\" href=\"/static/viewer.css?v=18eabefb1d726926\"><link rel=\"stylesheet\" href=\"/static/tokens.css?v=18eabefb1d3bf1bf\"><link rel=\"stylesheet\" href=\"/static/components.css?v=18eabefb212bd886\"><link rel=\"stylesheet\" href=\"/static/admin.css?v=18eabefb20819797\"><link rel=\"stylesheet\" href=\"/static/layout.css?v=18eabefb21a26735\"><link rel=\"stylesheet\" href=\"/static/boards.css?v=18eabefb20d2f568\">\n<script>\n/* Before first paint: \"system\" follows the device, and the chosen font applies (both are allow-listed words). */\n(function () {\n  var h = document.documentElement, f = {rounded: 'ui-rounded,\"SF Pro Rounded\",\"Hiragino Maru Gothic ProN\",system-ui,sans-serif', serif: 'ui-serif,Georgia,\"Times New Roman\",serif', mono: 'ui-monospace,SFMono-Regular,Menlo,monospace'};\n  if (h.dataset.mode === 'system' && window.matchMedia('(prefers-color-scheme: light)').matches) h.dataset.theme = 'light';\n  if (f[h.dataset.font]) h.style.setProperty('--font', f[h.dataset.font]);\n  if (window.matchMedia('(max-width:900px)').matches) h.classList.remove('cl');\n})();\nwindow.RELAY_ME = {\"device\": {\"name\": null, \"trusted\": false}, \"permissions\": [\"admin.open\", \"alert_events.view\", \"alerts.send\", \"alerts.view\", \"audio_mixers.view\", \"blackmagic.view\", \"boards.view\", \"captions.view\", \"crew.chat\", \"crew.checkin\", \"crew.checklist\", \"crew.nosound\", \"crew.resources\", \"crew.use\", \"crew.view\", \"dante.view\", \"intercom.use\", \"intercom.view\", \"intercom_remote.view\", \"lighting.view\", \"modules.view\", \"ndi.view\", \"network.view\", \"obs.view\", \"open_sound_meter.view\", \"overlays.view\", \"panels.view\", \"parent_paging.view\", \"planning_center.view\", \"prodmesh_rta.view\", \"propresenter.view\", \"reaper.view\", \"remote_access.view\", \"schedules.view\", \"screens.view\", \"session.view\", \"settings.view\", \"signage.view\", \"signage_web.view\", \"signalmap.view\", \"tally_arbiter.view\", \"unifi.view\", \"wireless_mics.view\", \"youtube.view\"], \"pin_set\": false, \"prefs\": {}, \"user\": {\"id\": 7, \"must_change_password\": false, \"name\": \"New Bie\", \"role\": \"viewer\", \"username\": \"newbie\"}};\nwindow.relayCan = function (perm) { return window.RELAY_ME.permissions.indexOf(perm) !== -1; };\n</script>\n</head><body>\n\n\n\n\n<div class=\"app\">\n<aside id=\"aside\"><div class=\"sbin\">\n  <div class=\"sbhead\"><h1 class=\"brand\"><span class=\"lk\"><svg class=\"lockup\" role=\"img\" aria-label=\"Relay\" xmlns=\"http://www.w3.org/2000/svg\" width=\"82\" height=\"24\" viewBox=\"0 0 219.3 64\"><g transform=\"translate(-15.3 -14.55) scale(1.4545)\"><rect x=\"11.5\" y=\"14\" width=\"9\" height=\"36.4\" rx=\"4.5\" fill=\"currentColor\"/><path fill-rule=\"evenodd\" fill=\"var(--brand,#4ade80)\" d=\"M33.5 14H44.5A9 9 0 0 1 53.5 23V30A9 9 0 0 1 49 37.8L52.6 48.2Q53.6 51.4 50.4 50.2L37 39H33.5A9 9 0 0 1 24.5 30V23A9 9 0 0 1 33.5 14ZM32.5 20.8H45.5A2 2 0 0 1 47.5 22.8V22.8A2 2 0 0 1 45.5 24.8H32.5A2 2 0 0 1 30.5 22.8V22.8A2 2 0 0 1 32.5 20.8ZM32.5 28.3H39.0A2 2 0 0 1 41.0 30.3V30.299999999999997A2 2 0 0 1 39.0 32.3H32.5A2 2 0 0 1 30.5 30.299999999999997V30.3A2 2 0 0 1 32.5 28.3Z\"/></g><path transform=\"translate(84.29 19.6) scale(0.62)\" d=\"M0 40V0M0 18A18 18 0 0 1 18 0M33 20H73A20 20 0 1 0 67.14 34.14M92 -24V40M151 20A20 20 0 1 0 151 20.01M151 0V40M170 0V20A20 20 0 0 0 210 20M210 0V44A16 16 0 0 1 194 60H186\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"9\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg></span><span class=\"mk\"><svg class=\"mark\" role=\"img\" aria-label=\"Relay\" xmlns=\"http://www.w3.org/2000/svg\" width=\"28\" height=\"28\" viewBox=\"0 0 64 64\"><rect x=\"11.5\" y=\"14\" width=\"9\" height=\"36.4\" rx=\"4.5\" fill=\"currentColor\"/><path fill-rule=\"evenodd\" fill=\"var(--brand,#4ade80)\" d=\"M33.5 14H44.5A9 9 0 0 1 53.5 23V30A9 9 0 0 1 49 37.8L52.6 48.2Q53.6 51.4 50.4 50.2L37 39H33.5A9 9 0 0 1 24.5 30V23A9 9 0 0 1 33.5 14ZM32.5 20.8H45.5A2 2 0 0 1 47.5 22.8V22.8A2 2 0 0 1 45.5 24.8H32.5A2 2 0 0 1 30.5 22.8V22.8A2 2 0 0 1 32.5 20.8ZM32.5 28.3H39.0A2 2 0 0 1 41.0 30.3V30.299999999999997A2 2 0 0 1 39.0 32.3H32.5A2 2 0 0 1 30.5 30.299999999999997V30.3A2 2 0 0 1 32.5 28.3Z\"/></svg></span></h1></div>\n  <nav id=\"nav\" class=\"nav sbscroll\" aria-label=\"Settings areas\">\n    \n    \n    <div class=\"has\" data-group=\"translation\"><button type=\"button\" class=\"nb\" data-tip=\"Transcription &amp; translation\" aria-expanded=\"false\"><svg class=\"i\" viewBox=\"0 0 16 16\" aria-hidden=\"true\"><path d=\"M2 4h7M5.5 2v2M3.5 4c.5 3 2.5 5 5 6M8 4c-.5 3-2.5 5-5.5 6.5M9 14l3-7 3 7M10 12h4\"/></svg><span class=\"nl\">Transcription &amp; translation</span><svg class=\"i chev\" viewBox=\"0 0 16 16\" aria-hidden=\"true\"><path d=\"M6 4l4 4-4 4\"/></svg></button><div class=\"subm\"><div><ul>\n      <li><a href=\"#health\" data-page=\"health\"><span class=\"nl\">Session health</span></a></li>\n      \n      \n      \n      \n      <li><a href=\"#urls\" data-page=\"urls\"><span class=\"nl\">Viewer links</span></a></li>\n      <li><a href=\"#overlay\" data-page=\"overlay\"><span class=\"nl\">Broadcast overlay</span></a></li>\n      \n    </ul></div></div></div>\n    \n    <div class=\"grp\">Output</div>\n    <a href=\"#panels\" data-page=\"panels\" data-tip=\"Panels\"><svg class=\"i\" viewBox=\"0 0 16 16\" aria-hidden=\"true\"><rect x=\"1.5\" y=\"3\" width=\"13\" height=\"9\" rx=\"1.5\"/><path d=\"M5.5 14.5h5\"/></svg><span class=\"nl\">Panels</span></a>\n    <a href=\"#alerts\" data-page=\"alerts\" data-tip=\"Alerts\"><svg class=\"i\" viewBox=\"0 0 16 16\" aria-hidden=\"true\"><path d=\"M4 11V7a4 4 0 0 1 8 0v4l1.5 1.5h-11zM6.5 14h3\"/></svg><span class=\"nl\">Alerts</span></a>\n    <a href=\"#screens\" data-page=\"screens\" data-tip=\"Screens\"><svg class=\"i\" viewBox=\"0 0 16 16\" aria-hidden=\"true\"><rect x=\"1.5\" y=\"2.5\" width=\"13\" height=\"9\" rx=\"1.5\"/><path d=\"M5.5 14h5M8 11.5V14\"/></svg><span class=\"nl\">Screens</span></a>\n    <a href=\"#boards\" data-page=\"boards\" data-tip=\"Boards\"><svg class=\"i\" viewBox=\"0 0 16 16\" aria-hidden=\"true\"><rect x=\"1.5\" y=\"2.5\" width=\"13\" height=\"11\" rx=\"1.5\"/><path d=\"M1.5 7.5h8M9.5 2.5v11\"/></svg><span class=\"nl\">Boards</span></a>\n    <a href=\"#schedules\" data-page=\"schedules\" data-tip=\"Schedules\"><svg class=\"i\" viewBox=\"0 0 16 16\" aria-hidden=\"true\"><rect x=\"2\" y=\"3\" width=\"12\" height=\"11\" rx=\"1.5\"/><path d=\"M2 7h12M5.5 1.5v3M10.5 1.5v3\"/></svg><span class=\"nl\">Schedules</span></a>\n    \n    \n    <div class=\"grp\">Settings</div>\n    \n    \n    <a href=\"#modules\" data-page=\"modules\" data-pages=\"modules network\" data-tabs='[[\"modules\", \"Modules\"], [\"network\", \"Network\"]]' data-tip=\"System\"><svg class=\"i\" viewBox=\"0 0 16 16\" aria-hidden=\"true\"><circle cx=\"8\" cy=\"8\" r=\"2.2\"/><path d=\"M8 1.5v1.6M8 12.9v1.6M1.5 8h1.6M12.9 8h1.6M3.4 3.4l1.1 1.1M11.5 11.5l1.1 1.1M3.4 12.6l1.1-1.1M11.5 4.5l1.1-1.1\"/></svg><span class=\"nl\">System</span></a>\n    \n  </nav>\n  <button type=\"button\" class=\"user\" id=\"userBtn\" aria-haspopup=\"menu\" aria-expanded=\"false\" aria-label=\"Account menu\"><span class=\"av\">N</span><span class=\"uinfo\"><b>New Bie</b><small>viewer</small></span></button>\n</div></aside>\n<div class=\"scrim\" id=\"scrim\"></div>\n<div class=\"inset\" id=\"inset\">\n<header class=\"top\">\n  <button type=\"button\" class=\"ib\" id=\"sbToggle\" aria-label=\"Toggle sidebar\"><svg class=\"i\" viewBox=\"0 0 16 16\" aria-hidden=\"true\"><rect x=\"2\" y=\"3\" width=\"12\" height=\"10\" rx=\"2\"/><path d=\"M6 3v10\"/></svg></button>\n  <span class=\"vsep\"></span>\n  <button type=\"button\" class=\"search\" id=\"searchBtn\" aria-label=\"Search pages and actions\"><svg class=\"i\" viewBox=\"0 0 16 16\" aria-hidden=\"true\"><circle cx=\"7\" cy=\"7\" r=\"4.5\"/><path d=\"M11 11l3 3\"/></svg><span>Search pages &amp; actions</span><kbd>&#8984;K</kbd></button>\n  <span class=\"crumb\" id=\"crumb\"></span>\n  <span class=\"sp\"></span>\n  <a href=\"#health\" class=\"spill off\" id=\"streamPill\" title=\"Open Session health\" aria-live=\"polite\"><span class=\"dot\" id=\"masterDot\"></span><span id=\"pillTxt\">STOPPED</span></a>\n  <span id=\"modulePills\"></span>\n  <span class=\"pill muted\" id=\"viewerCount\" style=\"font-weight:500\">0 viewers</span>\n  <button type=\"button\" class=\"ib\" id=\"lookBtn\" aria-label=\"Preferences\" aria-haspopup=\"dialog\" aria-expanded=\"false\"><svg class=\"i\" viewBox=\"0 0 16 16\" aria-hidden=\"true\"><circle cx=\"8\" cy=\"8\" r=\"2.2\"/><path d=\"M8 1.5v1.6M8 12.9v1.6M1.5 8h1.6M12.9 8h1.6M3.4 3.4l1.1 1.1M11.5 11.5l1.1 1.1M3.4 12.6l1.1-1.1M11.5 4.5l1.1-1.1\"/></svg></button>\n  <button type=\"button\" class=\"ib\" id=\"themeBtn\" aria-label=\"Change theme\"></button>\n  <button type=\"button\" class=\"ib\" id=\"acctBtn\" aria-label=\"Account\" aria-haspopup=\"menu\" aria-expanded=\"false\" style=\"width:auto;border:0\"><span class=\"av\">N</span></button>\n  <a class=\"acct\" href=\"#account\" id=\"acctLink\" title=\"My account\"><span class=\"acctname\">New Bie</span></a>\n  <form method=\"post\" action=\"/admin/logout\" id=\"logoutForm\" hidden></form>\n</header>\n<main><div class=\"wrap\">\n  <div id=\"alert\" class=\"field err\" hidden></div>\n\n  <div class=\"page\" id=\"page-health\" data-page=\"health\" hidden>\n    <h2 class=\"title\">Session health</h2>\n    <p class=\"sub\">Start and stop the stream, watch the live transcript and check each session.</p>\n    <p class=\"note viewonly\">You can view this page but not change it.</p>\n    <section>\n      <h3>Stream control</h3>\n      <div class=\"ctl\">\n        <span class=\"muted\" id=\"masterState\">Stopped</span>\n        <span class=\"spacer\"></span>\n        \n      </div>\n      <label class=\"check\"><input type=\"checkbox\" id=\"captionsToggle\" checked disabled> Run live captions and translation with Start</label>\n      <div class=\"note\">Shows whether the stream is running.</div>\n    </section>\n    <section>\n      <h3>No sound?</h3>\n      <div class=\"note\">Walks back from Relay's input and says where the sound stops and what to look at next.</div>\n      <div id=\"noSound\"></div>\n    </section>\n    <section>\n      <h3>Live transcript</h3>\n      <div class=\"feedbar\">\n        <select id=\"feedSel\" aria-label=\"Feed to watch\"><option value=\"\">Transcription (source)</option></select>\n        <label class=\"check feedscroll\"><input type=\"checkbox\" id=\"feedScroll\" checked> Auto-scroll</label>\n        <span class=\"muted\" id=\"feedState\"></span>\n      </div>\n      <div class=\"feedbox\" id=\"feedBox\" tabindex=\"0\" role=\"log\" aria-label=\"Live transcript\"></div>\n    </section>\n    <section>\n      <h3>Sessions</h3>\n    <div class=\"tablescroll\">\n      <table>\n        <thead><tr><th>Session</th><th>State</th><th>Last delta</th><th>Retries</th><th>Audio dropped</th><th>Cost</th></tr></thead>\n        <tbody id=\"sessions\"><tr><td colspan=\"6\" class=\"muted\">Not started.</td></tr></tbody>\n      </table>\n    </div>\n  </section>\n  </div>\n\n\n\n\n  <div class=\"page\" id=\"page-panels\" data-page=\"panels\" hidden>\n    <h2 class=\"title\">Panels <span class=\"sumstate\" id=\"panelsSum\"></span></h2>\n    <p class=\"sub\">Caption panels on the venue network. Click a panel name to see its settings.</p>\n    <p class=\"note viewonly\">You can view this page but not change it.</p>\n    \n    <section>\n      <h3>Paired panels</h3>\n      <div class=\"plist\" id=\"panelList\"><div class=\"muted\">No panels have checked in yet.</div></div>\n    </section>\n    <section>\n      <h3>Panel firmware</h3>\n    <div class=\"fwbox flat\" id=\"fwBox\">\n      <div id=\"fwTypes\"></div>\n      \n\n    </div>\n\n    </section>\n    <section>\n      <h3>How panels work</h3>\n      <div class=\"note\">\n      Caption panels on the venue network appear here by themselves. A feed you set is sent to the\n      panel at once; a change made at the panel&rsquo;s own screen afterwards wins until you set\n      one again. Forgetting a panel that is still switched on brings it straight back, unnamed.\n    </div>\n    </section>\n  </div>\n\n\n  <div class=\"page\" id=\"page-alerts\" data-page=\"alerts\" hidden>\n    <h2 class=\"title\">Alerts <span class=\"sumstate\" id=\"alertsSum\"></span></h2>\n    <p class=\"sub\">The band opens the sender page on a phone and taps a row. Each row is something they can send; each\n      column is a panel or browser screen. Tick a square to send that row to that screen.</p>\n    <p class=\"note viewonly\">You can view this page but not change it.</p>\n    <div class=\"abar\">\n      <div class=\"abar-link\" id=\"alertLinks\"></div>\n      \n    </div>\n    <section class=\"apatchsect\">\n      <div class=\"tablescroll\"><table class=\"apatch\" id=\"alertList\"></table></div>\n      \n      <div class=\"note\"><b>Alert buttons</b> flash until someone at the screen taps it, then the sender sees where it\n        was seen. <b>Stage messages</b> show words over whatever the screen shows, with nothing to tap, and end on\n        their own. A panel joins when it checks in; a browser screen joins when it is opened at its column&rsquo;s\n        link. <b>Test</b> shows &ldquo;Test from Relay&rdquo; on that one screen for a few seconds.</div>\n    </section>\n    <details class=\"sect\" id=\"alertSettings\">\n      <summary>Settings <span class=\"sumstate\" id=\"alertSetSum\"></span></summary>\n      <div class=\"row\">\n        <div class=\"field\">\n          <label for=\"alertAutoStop\">An alert stops flashing after</label>\n          <select id=\"alertAutoStop\" disabled>\n            <option value=\"30\">30 seconds</option>\n            <option value=\"60\">1 minute</option>\n            <option value=\"120\">2 minutes</option>\n            <option value=\"180\">3 minutes</option>\n            <option value=\"300\">5 minutes</option>\n            <option value=\"600\">10 minutes</option>\n          </select>\n          <div class=\"note\">If nobody taps. The sender then sees &ldquo;Not seen&rdquo; and can send again. The flash\n            is once a second, well under the rate where flashing becomes a seizure risk.</div>\n        </div>\n        <div class=\"field\">\n          <label for=\"msgSeconds\">A message stays (seconds)</label>\n          <input id=\"msgSeconds\" type=\"number\" min=\"3\" max=\"120\" disabled>\n        </div>\n        <div class=\"field\">\n          <label for=\"bannerSeconds\">A banner stays (seconds)</label>\n          <input id=\"bannerSeconds\" type=\"number\" min=\"30\" max=\"3600\" disabled>\n          <div class=\"note\">A banner is a strip across the top that stays up longer than a message.</div>\n        </div>\n      </div>\n      <div class=\"field\">\n        <label for=\"alertReplies\">Replies, one per line</label>\n        <textarea id=\"alertReplies\" rows=\"3\" placeholder=\"On my way&#10;Can't right now\" disabled></textarea>\n        <div class=\"note\">Tapped on the flashing screen instead of a plain acknowledge, so nobody needs a keyboard. The\n          sender sees it next to &ldquo;Seen&rdquo;. Up to 6, of 24 characters. Leave it empty for a plain acknowledge.</div>\n      </div>\n      <div class=\"field\">\n        <label class=\"chk chk-inline\"><input type=\"checkbox\" id=\"alertSignin\" disabled> Only signed-in people can send</label>\n        <div class=\"note\">Otherwise anyone with the sender link can send, so hand it to the band, not the room. With\n          sign-in on, the sender page moves to this panel&rsquo;s <span class=\"mono\">https://</span> address, and anyone\n          whose role can send alerts may use it, including a Member. Panels send as they always have.</div>\n      </div>\n    </details>\n    \n  </div>\n\n\n  <div class=\"page\" id=\"page-urls\" data-page=\"urls\" hidden>\n    <h2 class=\"title\">Viewer links</h2>\n    <p class=\"sub\">Open these on a screen or paste them into another app.</p>\n    <div class=\"urls\" id=\"urls\"></div>\n    <div class=\"urls\" id=\"secure\"></div>\n  </div>\n\n\n  <div class=\"page\" id=\"page-overlay\" data-page=\"overlay\" hidden>\n    <h2 class=\"title\">Broadcast overlay</h2>\n    <p class=\"sub\">Captions for your livestream as a browser source. Pick a layout, adjust it against the preview, then copy the link into OBS, vMix, ProPresenter or your switcher.</p>\n    <p class=\"note viewonly\">You can view this page but not change it.</p>\n    <div class=\"ovtabs\" role=\"tablist\">\n      <button type=\"button\" role=\"tab\" class=\"on\" aria-selected=\"true\" data-ovtab=\"build\">Build</button>\n      <button type=\"button\" role=\"tab\" aria-selected=\"false\" data-ovtab=\"guides\">Setup guides</button>\n    </div>\n\n    <div id=\"ovBuild\" class=\"ovb\">\n      <div class=\"ovb-controls\">\n        \n\n        <fieldset><legend>Layout</legend>\n          <div class=\"ovpresets\" id=\"ovPresets\"></div>\n        </fieldset>\n\n        <fieldset><legend>Captions</legend>\n          <div class=\"field\"><span class=\"lbl\">Show</span>\n            <div class=\"seg\" data-k=\"stream\"><button type=\"button\" data-v=\"translation\">Translation</button><button type=\"button\" data-v=\"transcription\">Original</button><button type=\"button\" data-v=\"both\">Two, stacked</button></div></div>\n          <div class=\"row\">\n            <div class=\"field\" id=\"ovLangF\"><label for=\"ovLang\" id=\"ovLangLbl\">Language</label><select id=\"ovLang\" data-k=\"lang\"></select></div>\n            <div class=\"field\" id=\"ovLang2F\"><label for=\"ovLang2\">Second language</label><select id=\"ovLang2\" data-k=\"lang2\"></select></div>\n          </div>\n          <div class=\"field\"><label for=\"ovLines\">Lines on screen</label><div class=\"rng\"><input id=\"ovLines\" type=\"range\" min=\"1\" max=\"8\" data-k=\"lines\"><output></output></div></div>\n          <label class=\"chk\"><input type=\"checkbox\" data-k=\"finals\"><span>Finished lines only<small>Waits for each sentence to settle, so words never change on air. About a second later than live.</small></span></label>\n          <div class=\"field\"><span class=\"lbl\">Style</span>\n            <div class=\"seg\" data-k=\"mode\"><button type=\"button\" data-v=\"rollup\">Roll-up</button><button type=\"button\" data-v=\"popon\">Pop-on</button></div>\n            <p class=\"note\" id=\"ovModeHint\"></p></div>\n          <div class=\"field\"><label for=\"ovHold\">Hide after silence</label><div class=\"rng\"><input id=\"ovHold\" type=\"range\" min=\"0\" max=\"30000\" step=\"1000\" data-k=\"hold\"><output></output></div></div>\n          <label class=\"chk\" id=\"ovLabelsF\"><input type=\"checkbox\" data-k=\"labels\"><span>Language names over each feed</span></label>\n        </fieldset>\n\n        <fieldset><legend>Position &amp; size</legend>\n          <div class=\"field\"><span class=\"lbl\">Position</span><div class=\"seg\" data-k=\"pos\"><button type=\"button\" data-v=\"top\">Top</button><button type=\"button\" data-v=\"middle\">Middle</button><button type=\"button\" data-v=\"bottom\">Bottom</button></div></div>\n          <div class=\"field\"><span class=\"lbl\">Alignment</span><div class=\"seg\" data-k=\"align\"><button type=\"button\" data-v=\"left\">Left</button><button type=\"button\" data-v=\"center\">Centre</button><button type=\"button\" data-v=\"right\">Right</button></div></div>\n          <div class=\"field\"><label for=\"ovFont\">Text size</label><div class=\"rng\"><input id=\"ovFont\" type=\"range\" min=\"20\" max=\"160\" data-k=\"font\"><output></output></div></div>\n          <div class=\"field\"><label for=\"ovMaxw\">Max width</label><div class=\"rng\"><input id=\"ovMaxw\" type=\"range\" min=\"20\" max=\"100\" data-k=\"maxw\"><output></output></div></div>\n          <div class=\"field\"><label for=\"ovSafe\">Title-safe margin</label><div class=\"rng\"><input id=\"ovSafe\" type=\"range\" min=\"0\" max=\"15\" step=\"0.5\" data-k=\"safe\"><output></output></div></div>\n          <div class=\"field\"><label for=\"ovRes\">Canvas</label><select id=\"ovRes\" data-k=\"res\">\n            <option value=\"1920x1080\">1920 × 1080 (1080p)</option><option value=\"1280x720\">1280 × 720 (720p)</option>\n            <option value=\"3840x2160\">3840 × 2160 (4K)</option><option value=\"1080x1920\">1080 × 1920 (vertical)</option></select>\n            <p class=\"note\">Match your OBS or vMix canvas. The overlay scales if the source is another size.</p></div>\n        </fieldset>\n\n        <fieldset><legend>Look</legend>\n          <div class=\"field\"><label for=\"ovFamily\">Font</label><select id=\"ovFamily\" data-k=\"family\">\n            <option value=\"sans\">Sans (default)</option><option value=\"serif\">Serif (Source Serif)</option>\n            <option value=\"rounded\">Rounded</option><option value=\"hyper\">Atkinson Hyperlegible (easiest to read)</option>\n            <option value=\"mono\">Monospace (caption-box look)</option></select></div>\n          <div class=\"field\"><span class=\"lbl\">Text edge</span><div class=\"seg\" data-k=\"edge\"><button type=\"button\" data-v=\"plate\">Plate</button><button type=\"button\" data-v=\"outline\">Outline</button><button type=\"button\" data-v=\"shadow\">Shadow</button><button type=\"button\" data-v=\"none\">None</button></div></div>\n          <div class=\"row ovcolours\">\n            <div class=\"field\"><label for=\"ovColor\">Text colour</label><input id=\"ovColor\" type=\"color\" data-k=\"color\"></div>\n            <div class=\"field\" id=\"ovPlatecF\"><label for=\"ovPlatec\">Plate colour</label><input id=\"ovPlatec\" type=\"color\" data-k=\"platec\"></div>\n            <div class=\"field ovwide\" id=\"ovPlateF\"><label for=\"ovPlate\">Plate opacity</label><div class=\"rng\"><input id=\"ovPlate\" type=\"range\" min=\"0\" max=\"1\" step=\"0.05\" data-k=\"plate\"><output></output></div></div>\n          </div>\n        </fieldset>\n\n        <fieldset><legend>Output</legend>\n          <div class=\"field\"><span class=\"lbl\">Background</span>\n            <div class=\"seg\" data-k=\"out\"><button type=\"button\" data-v=\"transparent\">Transparent</button><button type=\"button\" data-v=\"green\">Chroma green</button><button type=\"button\" data-v=\"matte\">Key matte</button><button type=\"button\" data-v=\"black\">Black</button></div>\n            <p class=\"note\" id=\"ovBgHint\"></p></div>\n        </fieldset>\n      </div>\n\n      <div class=\"ovb-preview\">\n        <div class=\"ovstagebar\">\n          <span class=\"lbl\">Preview</span>\n          <div class=\"seg seg-auto\" id=\"ovBackdrop\"><button type=\"button\" data-v=\"program\" class=\"on\">Over video</button><button type=\"button\" data-v=\"checker\">Transparency</button><button type=\"button\" data-v=\"black\">Black</button></div>\n          <label class=\"chk chk-inline\"><input type=\"checkbox\" id=\"ovGuideLines\" checked> Title-safe guide</label>\n        </div>\n        <div class=\"ovstage bk-program\" id=\"ovStage\">\n          <iframe id=\"ovFrame\" title=\"Overlay preview\" tabindex=\"-1\"></iframe>\n          <div class=\"ovsafe\" id=\"ovSafe-guide\" aria-hidden=\"true\"></div>\n        </div>\n        <label class=\"chk chk-inline\" style=\"margin-top:8px\"><input type=\"checkbox\" id=\"ovSample\" checked> Sample captions <span class=\"muted\">(off shows the live feed)</span></label>\n\n        <div class=\"ovlink\">\n          <span class=\"lbl\">Browser source link</span>\n          <div class=\"ovurl mono\" id=\"ovUrl\"></div>\n          <div class=\"ovacts\">\n            <button type=\"button\" class=\"primary\" id=\"ovCopy\">Copy link</button>\n            <a class=\"btnlink\" id=\"ovOpen\" target=\"_blank\" rel=\"noopener\">Open</a>\n          </div>\n          \n        </div>\n\n        <div class=\"ovsaved\">\n          <h3>Saved overlays</h3>\n          <table><thead><tr><th>Name</th><th>Link</th><th></th></tr></thead>\n            <tbody id=\"ovList\"><tr><td colspan=\"3\" class=\"muted\">None saved yet.</td></tr></tbody></table>\n        </div>\n      </div>\n    </div>\n\n    <div id=\"ovGuides\" class=\"ovguides\" hidden>\n      <p class=\"sub\">Copy the link from the Build tab first. Use the canvas size your switcher runs at; the overlay is transparent everywhere except the captions.</p>\n      <div class=\"ovrecipes\">\n        <div><h3>OBS Studio</h3><p class=\"note\">Browser source · your canvas size · transparent</p><ol>\n          <li>Sources → + → <strong>Browser</strong>. Name it “Relay captions”.</li>\n          <li>Paste the link into URL. Set width and height to your canvas (Settings → Video → Base resolution).</li>\n          <li>Untick <em>Shutdown source when not visible</em> so captions do not restart when you change scenes.</li>\n          <li>Drag it above your camera sources in every scene that needs captions, or put it in a nested scene shared by all of them.</li></ol></div>\n        <div><h3>vMix</h3><p class=\"note\">Web Browser input · 1920 × 1080 · transparent</p><ol>\n          <li>Add Input → <strong>Web Browser</strong>, paste the link, and set the size to your output resolution.</li>\n          <li>Put it on an Overlay channel (1–4) and press it on.</li>\n          <li>To caption the stream only, take it on the stream output’s overlay channel and leave the projector output clean.</li></ol></div>\n        <div><h3>ProPresenter</h3><p class=\"note\">Web Page object on a Prop · stream Look only</p><ol>\n          <li>Create a Prop with a <strong>Web Page</strong> object filling the slide; paste the link.</li>\n          <li>In <strong>Looks</strong>, turn Props on for the stream screen and off for the room screens.</li>\n          <li>Trigger the Prop at the start of the service; it stays up while slides change.</li></ol></div>\n        <div><h3>Blackmagic ATEM</h3><p class=\"note\">Upstream key · switcher format</p><ol>\n          <li><strong>Chroma green</strong>: open the link full-screen on a computer whose HDMI feeds one ATEM input, then use a Chroma key on that input.</li>\n          <li><strong>Key matte</strong>: save two overlays, one with <em>Key matte</em> and one with <em>Black</em>; feed each to its own input and set a Luma key with the black one as fill and the matte as key.</li>\n          <li>Turn the key on for program. Keep the computer’s screen saver and notifications off.</li></ol></div>\n      </div>\n    </div>\n  </div>\n\n\n  <div class=\"page\" id=\"page-screens\" data-page=\"screens\" hidden>\n    \n    <h2 class=\"title\">Screens</h2>\n    <p class=\"sub\">Every TV, tablet and panel, once, with one name and one place. A screen shows a board or a signage playlist, and flashes for alerts.</p>\n    <p class=\"note viewonly\">You can view this page but not change it.</p>\n    <div class=\"note err\" id=\"scErr\" hidden></div>\n    <div class=\"note ok\" id=\"scMsg\" hidden></div>\n    <div class=\"ctl\"><button type=\"button\" id=\"scAddPlace\">Add place</button></div>\n    <div id=\"scMain\"><p class=\"muted\">Loading&hellip;</p></div>\n    <section class=\"sc-edit\" id=\"scEdit\" hidden></section>\n  </div>\n\n\n  <div class=\"page\" id=\"page-boards\" data-page=\"boards\" hidden>\n    \n    <p class=\"note viewonly\">You can view this page but not change it.</p>\n    <div class=\"note err\" id=\"bdErr\" hidden></div>\n    <div class=\"bd bp\">\n      <nav class=\"blist\" id=\"bdList\" aria-label=\"Boards\"></nav>\n      <div id=\"bdMain\"><p class=\"muted\">Loading&hellip;</p></div>\n    </div>\n    <input type=\"file\" id=\"bdImport\" accept=\".json,application/json\" hidden>\n  </div>\n\n\n\n  <div class=\"page\" id=\"page-schedules\" data-page=\"schedules\" hidden>\n    <h2 class=\"title\">Schedules</h2>\n    <p class=\"sub\">Named schedules that start and stop capture and drive signage, boards and call times.</p>\n    <p class=\"note viewonly\">You can view this page but not change it.</p>\n    <section>\n      <h3>Schedules</h3>\n    <div class=\"note\" style=\"margin:0 0 12px\" id=\"schedStatus\">No schedules set. The stream only starts when you press <em>Start</em>.</div>\n    <p class=\"note\" style=\"margin:0 0 12px\">Named, reusable schedules. Signage slots, board rotation rows and crew call times pick one by name, so changing it here moves every place that uses it. Times follow Relay's time zone: <strong id=\"schedZone\"></strong> (Settings, System).</p>\n    <table>\n      <thead><tr><th>Schedule</th><th>Next start</th><th style=\"width:52px\">On</th><th></th></tr></thead>\n      <tbody id=\"schedList\"><tr><td colspan=\"4\" class=\"muted\">No schedules yet.</td></tr></tbody>\n    </table>\n    \n    </section>\n\n    \n\n    <section>\n      <h3>How schedules work</h3>\n    <div class=\"note\" style=\"margin-top:0\">\n      Capture starts and stops on its own inside each window of the schedules ticked for it. If it is already running when a\n      window opens, it keeps running and stops at the window&rsquo;s end. Pressing <em>Stop</em>\n      during a window holds it until the next scheduled start. Starting by hand outside a window\n      is never stopped by a schedule. Windows that overlap or touch run as one session.\n      <br>Times follow Relay's time zone, including daylight saving. The machine and the\n      relay must be running for a schedule to fire; a window already under way when the relay\n      starts is picked up, and one missed entirely is skipped.\n    </div>\n    </section>\n  </div>\n\n\n\n\n\n\n  <div class=\"page\" id=\"page-modules\" data-page=\"modules\" hidden>\n    <h2 class=\"title\">Modules</h2>\n    <p class=\"sub\">Integrations with other products. Each is switched on and set up on its own; one that is off\n      runs nothing and adds nothing to Relay.</p>\n    <p class=\"note viewonly\">You can view this page but not change it.</p>\n    <section>\n      <h3>Installed modules</h3>\n      <div class=\"plist\" id=\"moduleList\"><div class=\"muted\">Loading&hellip;</div></div>\n      <div class=\"note\">Modules ship inside Relay&rsquo;s signed release and update with it. Switching one on or off\n        reloads this page so its settings pages appear or go.</div>\n    </section>\n  </div>\n\n\n  \n  <div class=\"page\" id=\"page-network\" data-page=\"network\" hidden>\n    <h2 class=\"title\">Network <span class=\"sumstate\" id=\"nmSum\"></span></h2>\n    <p class=\"note viewonly\">You can view this page but not change it.</p>\n    <div class=\"tabs nmtabs\" role=\"tablist\" id=\"nmTabs\">\n      <button type=\"button\" role=\"tab\" data-tab=\"racks\" aria-selected=\"true\">Racks</button>\n      <button type=\"button\" role=\"tab\" data-tab=\"map\" data-alias=\"network_map\" aria-selected=\"false\">Map</button>\n      <button type=\"button\" role=\"tab\" data-tab=\"ports\" aria-selected=\"false\">Ports and notes</button>\n      <button type=\"button\" role=\"tab\" data-tab=\"computer\" aria-selected=\"false\">This computer</button>\n      <button type=\"button\" role=\"tab\" data-tab=\"find\" aria-selected=\"false\">Find and add</button>\n      \n    </div>\n\n    <div class=\"nmpane on\" data-pane=\"racks\" role=\"tabpanel\">\n      <div class=\"nmsplit\">\n        <div class=\"nmstack\">\n          <section class=\"nmlook\" id=\"nmLook\" hidden>\n            <div class=\"nmbetween\"><h3>Needs a look</h3><span class=\"muted\" id=\"nmChecked\"></span></div>\n            <div id=\"nmIssues\"></div>\n          </section>\n          <section class=\"nmbetween\">\n            <div><b>Every switch, drawn where it hangs</b> <span class=\"muted\">Click a port to see what is plugged in. Hover for link, PoE and your note.</span></div>\n            <div class=\"seg nmhl\" id=\"nmHl\" role=\"group\" aria-label=\"Show\"><button type=\"button\" data-v=\"all\">All</button><button type=\"button\" data-v=\"ndi\">NDI</button><button type=\"button\" data-v=\"dante\">Dante</button><button type=\"button\" data-v=\"poe\">PoE</button><button type=\"button\" data-v=\"check\">Problems</button></div>\n          </section>\n          <div class=\"nmlegend\"><span><i class=\"ok\"></i>Link up</span><span><i class=\"warn\"></i>Slow or errors</span><span><i class=\"poe\"></i>Powered (PoE)</span><span><i class=\"ndi\"></i>NDI</span><span><i class=\"dante\"></i>Dante</span></div>\n          <div class=\"nmclosets\" id=\"nmClosets\"></div>\n          <p class=\"note\" id=\"nmNoGear\" hidden>Switches are drawn from a module that reads them, such as UniFi. Turn one on in <a href=\"#modules\">Modules</a>; the map and the device list work without one.</p>\n        </div>\n        <div class=\"nmstack nmdrawer\" id=\"nmDrawer\"></div>\n      </div>\n    </div>\n\n    <div class=\"nmpane\" data-pane=\"map\" role=\"tabpanel\">\n      <div class=\"nmsplit\">\n        <div class=\"nmstack\">\n          <div class=\"nmtoolbar\">\n            <div class=\"seg\" id=\"nmFilter\" role=\"group\" aria-label=\"Show\"><button type=\"button\" data-v=\"all\">All</button><button type=\"button\" data-v=\"av\">AV only</button><button type=\"button\" data-v=\"ndi\">NDI</button><button type=\"button\" data-v=\"dante\">Dante</button></div>\n            <span class=\"nmgrow\"></span>\n            <span class=\"nmlegend\"><span><i class=\"ndi\"></i>NDI</span><span><i class=\"dante\"></i>Dante</span><span><i class=\"warn\"></i>Slow link</span></span>\n          </div>\n          <div class=\"nmframe\" id=\"nmMap\" tabindex=\"0\" aria-label=\"Network map\"></div>\n        </div>\n        <div class=\"nmstack nmdrawer\" id=\"nmMapDetail\"></div>\n      </div>\n    </div>\n\n    <div class=\"nmpane\" data-pane=\"ports\" role=\"tabpanel\">\n      <section>\n        <h3>Every device and the port it is on</h3>\n        <p class=\"note\">One row per device Relay can see. Where it is plugged in comes from the switches; the name and note are yours. Click a name to call it what your team calls it: the new name shows everywhere in Relay, but the device and the module that found it keep their own.</p>\n        <div class=\"nmtoolbar\">\n          <input type=\"search\" id=\"nmSearch\" placeholder=\"Find name, IP or MAC\" aria-label=\"Find name, IP or MAC\" autocomplete=\"off\">\n          <div class=\"seg\" id=\"nmPortFilter\" role=\"group\" aria-label=\"Show\"><button type=\"button\" data-v=\"all\">All</button><button type=\"button\" data-v=\"av\">AV only</button><button type=\"button\" data-v=\"ndi\">NDI</button><button type=\"button\" data-v=\"dante\">Dante</button><button type=\"button\" data-v=\"check\">Needs a look</button></div>\n          <span class=\"nmgrow\"></span>\n          <select id=\"nmSwitch\" aria-label=\"Switch\"><option value=\"\">Every switch</option></select>\n        </div>\n        <div class=\"tablescroll\"><table class=\"dt nmdevs\">\n          <thead><tr><th>Name in Relay</th><th>What</th><th>Address</th><th>Plugged into</th><th>Link</th><th>PoE</th><th>Carries</th><th>Note</th></tr></thead>\n          <tbody id=\"nmRows\"><tr><td colspan=\"8\" class=\"muted\">Loading&hellip;</td></tr></tbody>\n        </table></div>\n        <div class=\"ctl nmsave\"><button type=\"button\" class=\"primary\" id=\"nmSaveNotes\">Save notes</button><span class=\"muted\">A name is saved when you press Enter. Names and notes are kept with the device&rsquo;s MAC, so they survive a new address; nothing is sent to the device.</span></div>\n        <div class=\"err\" id=\"nmErr\" hidden></div>\n      </section>\n      <section id=\"nmCables\">\n        <h3>Cables</h3>\n        <p class=\"note\">A cable joins any two ports on any gear, and every page that draws cables draws this list: one recorded on the Blackmagic page shows here, and the other way round. A cable a module reports, such as a device on a UniFi switch port, cannot be removed here; add a note to it instead.</p>\n        <div class=\"tablescroll\"><table class=\"dt nmcables\">\n          <thead><tr><th>One end</th><th>The other end</th><th>Recorded by</th><th>Note</th><th></th></tr></thead>\n          <tbody id=\"nmCableRows\"><tr><td colspan=\"5\" class=\"muted\">Loading&hellip;</td></tr></tbody>\n        </table></div>\n        <div class=\"nmtoolbar nmaddcable\">\n          <div class=\"nmpick\" id=\"nmCableA\"></div>\n          <div class=\"nmpick\" id=\"nmCableB\"></div>\n          <input type=\"text\" id=\"nmCableNote\" maxlength=\"300\" placeholder=\"Note (optional)\" aria-label=\"Note for the new cable\">\n          <button type=\"button\" class=\"primary\" id=\"nmAddCable\">Add cable</button>\n        </div>\n        <div class=\"err\" id=\"nmCableErr\" hidden></div>\n      </section>\n      <section id=\"nmChannels\">\n        <h3>Channels</h3>\n        <p class=\"note\">A channel is one audio, video or talk signal, such as &ldquo;Camera 2&rdquo;. Each module reports its own: NDI a source, Blackmagic a switcher input, the audio bus a lane. Relay never joins two by itself; where two look like one it suggests the join and you decide. A name you type here shows on every page that uses the channel.</p>\n        <div id=\"nmChanSuggest\"></div>\n        <div class=\"tablescroll\"><table class=\"dt nmchannels\">\n          <thead><tr><th>Name</th><th>Kind</th><th>Reported by</th><th>Note</th><th></th></tr></thead>\n          <tbody id=\"nmChanRows\"><tr><td colspan=\"5\" class=\"muted\">Loading&hellip;</td></tr></tbody>\n        </table></div>\n        <div class=\"err\" id=\"nmChanErr\" hidden></div>\n      </section>\n    </div>\n\n    <div class=\"nmpane\" data-pane=\"computer\" role=\"tabpanel\">\n      <div class=\"nmwhat\"><b>This computer&rsquo;s network ports, and which one each kind of Relay traffic uses</b>\n        <p>Traffic with no port chosen uses the system&rsquo;s default network. A change applies at once; one that would take the panel off the address you are using is refused.</p></div>\n      <div id=\"netWarnings\" class=\"netwarn\" hidden></div>\n    <section>\n      <h3>Ports</h3>\n      <table class=\"nettable\">\n        <thead><tr><th>Port</th><th>Address</th><th>Link</th><th>Speed</th><th>Traffic on it</th><th></th></tr></thead>\n        <tbody id=\"netPorts\"><tr><td colspan=\"6\" class=\"muted\">Loading&hellip;</td></tr></tbody>\n      </table>\n      <div class=\"note\">Updates by itself when a cable is pulled or an adapter plugged in.</div>\n    </section>\n    <section>\n      <h3>Traffic</h3>\n      <table class=\"nettable\">\n        <thead><tr><th>Traffic</th><th>Network port</th><th>If the port is missing</th><th>Status</th><th></th></tr></thead>\n        <tbody id=\"netClasses\"><tr><td colspan=\"5\" class=\"muted\">Loading&hellip;</td></tr></tbody>\n      </table>\n      <div class=\"note\">A change applies at once: Relay moves its pages and tells each module. The operator panel\n        always answers on this computer too (127.0.0.1), and a change that would take it off the address you are\n        using is refused; make it on this computer instead.</div>\n      <div class=\"err\" id=\"netError\" hidden></div>\n    </section>\n    </div>\n\n    <div class=\"nmpane\" data-pane=\"find\" role=\"tabpanel\">\n      <div class=\"nmwhat\"><b>Where the map comes from</b>\n        <p>Relay merges what each source sees: a device seen by two sources is drawn once. Modules add more; turning one off removes only what it added.</p></div>\n      <section><div id=\"nmSources\"></div></section>\n      <div class=\"ctl\"><button type=\"button\" id=\"nmRefresh\">Look again now</button><span class=\"muted\" id=\"nmStatus\" aria-live=\"polite\">Loading&hellip;</span></div>\n      <section>\n        <h3>Racks and closets</h3>\n        <p class=\"note\">Which closet each switch is drawn in, top to bottom. A switch found later lands in Not placed until you give it one. A place with no switches in it goes when you save.</p>\n        <div class=\"tablescroll\"><table class=\"dt\">\n          <thead><tr><th>Order</th><th>Name</th><th>Model</th><th>Address</th><th>Where</th></tr></thead>\n          <tbody id=\"nmPlaceRows\"></tbody>\n        </table></div>\n        <div class=\"nmtoolbar nmaddplace\"><input type=\"text\" id=\"nmNewPlace\" maxlength=\"40\" placeholder=\"Booth rack\" aria-label=\"New place\"><button type=\"button\" id=\"nmAddPlace\">Add a place</button><span class=\"nmgrow\"></span><button type=\"button\" class=\"primary\" id=\"nmSavePlaces\">Save places</button></div>\n      </section>\n    </div>\n    \n  </div>\n\n\n\n\n\n\n  <div class=\"page\" id=\"page-account\" data-page=\"account\" hidden>\n    <h2 class=\"title\">My account</h2>\n    <p class=\"sub\" id=\"acctWho\"></p>\n    <section>\n      <h3>Password</h3>\n      <form id=\"pwForm\" class=\"acctform\" autocomplete=\"off\">\n        <div class=\"field\"><label for=\"pwCurrent\">Current password</label><input id=\"pwCurrent\" type=\"password\" autocomplete=\"current-password\" required></div>\n        <div class=\"field\"><label for=\"pwNew\">New password</label><input id=\"pwNew\" type=\"password\" autocomplete=\"new-password\" minlength=\"8\" required></div>\n        <div class=\"field\"><label for=\"pwConfirm\">New password again</label><input id=\"pwConfirm\" type=\"password\" autocomplete=\"new-password\" minlength=\"8\" required></div>\n        <button class=\"primary\" type=\"submit\">Change password</button>\n        <div class=\"note\">At least 8 characters. Changing it signs you out of other browsers.</div>\n      </form>\n    </section>\n    <section>\n      <h3>PIN</h3>\n      <div class=\"note\" style=\"margin:0 0 12px\">A PIN is 4 to 8 digits, for signing in quickly. It only works on a trusted device.\n        <span id=\"pinState\"></span></div>\n      <form id=\"pinForm\" class=\"acctform\" autocomplete=\"off\">\n        <div class=\"field\"><label for=\"pinPassword\">Your password</label><input id=\"pinPassword\" type=\"password\" autocomplete=\"current-password\" required></div>\n        <div class=\"field\"><label for=\"pinNew\">PIN</label><input id=\"pinNew\" type=\"password\" inputmode=\"numeric\" pattern=\"[0-9]*\" minlength=\"4\" maxlength=\"8\" autocomplete=\"off\" required></div>\n        <div class=\"ctl\">\n          <button class=\"primary\" type=\"submit\" id=\"pinSave\">Set PIN</button>\n          <button type=\"button\" id=\"pinRemove\" hidden>Remove PIN</button>\n        </div>\n      </form>\n    </section>\n    <section>\n      <h3>My phones</h3>\n      <div class=\"note\">The phones and computers you have set up, with what each is set up for. Forgetting one signs it out of the intercom,\n        stops its crew notifications, takes it off check-in and ends its PIN sign-in.</div>\n      <div class=\"tablescroll\">\n        <table>\n          <thead><tr><th>Phone</th><th>Set up for</th><th>Last seen</th><th><span class=\"sr\">Actions</span></th></tr></thead>\n          <tbody id=\"myPhoneList\"><tr><td colspan=\"4\" class=\"muted\">Loading&hellip;</td></tr></tbody>\n        </table>\n      </div>\n    </section>\n    \n    <section>\n      <h3>This browser</h3>\n      <div class=\"note\" style=\"margin-top:0\" id=\"deviceState\"></div>\n    </section>\n  </div>\n</div></main>\n</div></div>\n<div id=\"drawerBg\" hidden></div>\n<aside id=\"drawer\" aria-hidden=\"true\" aria-labelledby=\"dTitle\" hidden>\n  <header><h2 id=\"dTitle\"></h2><button type=\"button\" id=\"dClose\" aria-label=\"Close\"><svg class=\"ic\" viewBox=\"0 0 16 16\" aria-hidden=\"true\"><path d=\"M3.5 3.5l9 9M12.5 3.5l-9 9\"/></svg></button></header>\n  <div class=\"dbody\" id=\"dBody\"></div>\n  <div class=\"dfoot\" id=\"dFoot\"></div>\n</aside>\n\n<div id=\"toast\" role=\"status\" aria-live=\"polite\"></div>\n<div id=\"pal\" role=\"dialog\" aria-label=\"Search pages and actions\"><div class=\"box\"><input id=\"q\" placeholder=\"Search pages and actions…\" autocomplete=\"off\" aria-label=\"Search pages and actions\"><div id=\"res\" role=\"listbox\"></div></div></div>\n<script src=\"/static/relay-ui.js?v=18eabefb21e0f8ff\"></script>\n<script src=\"/static/qrcode.min.js?v=18eabefb21da73b8\"></script>\n<script src=\"/static/alert-icons.js?v=18eabefb20a83b8c\"></script>\n<script src=\"/static/layout-render.js?v=18eabefb218e867c\"></script>\n<script src=\"/static/layout-editor.js?v=18eabefb218288fa\"></script>\n<script src=\"/static/board-live.js?v=18eabefb20c750ee\"></script>\n<script src=\"/static/shell.js?v=18eabefb1d1cdd2e\"></script>\n<script src=\"/static/admin.js?v=18eabefb20984763\"></script>\n<script src=\"/static/modules.js?v=18eabefb21b8a2f4\"></script>\n<script src=\"/static/network.js?v=18eabefb21bcd269\"></script>\n<script src=\"/static/network_map.js?v=18eabefb21cb34b6\"></script>\n<script src=\"/static/network_channels.js?v=18eabefb21c135c9\"></script>\n<script src=\"/static/audiobus.js?v=18eabefb20bb79ff\"></script>\n<script src=\"/static/aimodels.js?v=18eabefb20a23081\"></script>\n<script src=\"/static/overlay-builder.js?v=18eabefb21d587ca\"></script>\n<script src=\"/static/boards.js?v=18eabefb20da4c7c\"></script>\n<script src=\"/static/screens.js?v=18eabefb1d103184\"></script>\n<script src=\"/static/users.js?v=18eabefb1d4