 "html": "\n<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1, viewport-fit=cover\">\n<meta name=\"referrer\" content=\"no-referrer\">\n<link rel=\"stylesheet\" href=\"/static/tokens.css\"><link rel=\"stylesheet\" href=\"/static/modules/ndi/view.css\"><title>Stage</title>\n<style>\nhtml, body { margin: 0; height: 100%; background: #000; color: #fff; font:16px/1.3 var(--font); }\n#ndv { box-sizing: border-box; height: 100%; display: flex; flex-direction: column; border: 8px solid transparent; }\n#ndv[data-tally=\"program\"] { border-color: #e03131; }\n#ndv[data-tally=\"preview\"] { border-color: #2f9e44; }\n#ndvPic { flex: 1; min-height: 0; display: flex; align-items: center; justify-content: center; }\n#ndvPic img { max-width: 100%; max-height: 100%; object-fit: contain; }\n#ndvBar { display: flex; gap: 16px; align-items: center; padding: 6px 10px; font-size: 14px; color: #bbb; }\n#ndvBar b { color: #fff; font-weight: 600; }\n#ndvMeter { flex: 0 0 120px; height: 8px; background: #333; border-radius: 4px; overflow: hidden; }\n#ndvMeter i { display: block; height: 100%; width: 0; background: #40c057; transition: width .15s; }\n#ndvMsg { margin-left: auto; color: #fab005; }\n</style>\n</head>\n<body>\n<main id=\"ndv\" data-tally=\"\">\n  <div id=\"ndvPic\"><img id=\"ndvImg\" alt=\"Stage\"><div id=\"ndvAudioOnly\" hidden>Audio only</div></div>\n  <div id=\"ndvBar\"><b>Stage</b><span>CAM</span><span id=\"ndvInfo\"></span>\n    <div id=\"ndvSound\" hidden>\n      <div id=\"ndvMeters\" title=\"Level of each channel\"></div><span id=\"ndvLoud\" title=\"Momentary loudness\"></span>\n      <span id=\"ndvChans\" role=\"group\" aria-label=\"Channels to hear\"></span>\n      <button type=\"button\" id=\"ndvListen\" aria-pressed=\"false\">Listen</button>\n    </div><span id=\"ndvMsg\" role=\"status\" aria-live=\"polite\"></span></div>\n</main>\n<script id=\"ndvData\" type=\"application/json\">{\"camera\": 3, \"machine\": \"CAM\", \"source\": \"CAM (Stage)\", \"title\": \"Stage\"}</script>\n<script src=\"/static/modules/ndi/view.js\"></script>\n</body>\n</html>"
