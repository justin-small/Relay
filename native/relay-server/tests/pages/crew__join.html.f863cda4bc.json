 "context": {
  "app_name": "Relay crew",
  "crew_url": "https://192.168.1.5:8001/crew",
  "have_cert": false
 },
 "html": "<!doctype html>\n<html lang=\"en\"><head>\n<meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1,viewport-fit=cover\">\n<meta name=\"theme-color\" content=\"#000000\"><title>Join Relay crew</title><style>\n  :root { --bg: #09090b; --fg: #fafafa; --muted: #a1a1aa; --card: #111113; --line: #27272a; --primary: #4ade80; --primary-fg: #052e16;\n          --r: 14px; color-scheme: dark; }\n  * { box-sizing: border-box; }\n  body { margin: 0; background: var(--bg); color: var(--fg); font: 1rem/1.5 system-ui, -apple-system, sans-serif; }\n  main { min-height: 100vh; min-height: 100dvh; max-width: 34em; margin: 0 auto; display: flex; flex-direction: column; gap: 1rem;\n         padding: calc(1.5rem + env(safe-area-inset-top)) 1.25rem calc(1.25rem + env(safe-area-inset-bottom)); }\n  header { text-align: center; padding: 1rem 0 .25rem; }\n  header img { width: 3.5rem; height: 3.5rem; }\n  h1 { font-size: 1.5rem; margin: .6rem 0 .25rem; }\n  p, li span { color: var(--muted); margin: 0; }\n  .seg { display: flex; border: 1px solid var(--line); border-radius: calc(var(--r) - 4px); overflow: hidden; }\n  .seg button { flex: 1; min-height: 2.75rem; padding: .5rem .75rem; border: 0; background: none; color: var(--muted); font: inherit; cursor: pointer; }\n  .seg button + button { border-left: 1px solid var(--line); }\n  .seg button[aria-pressed=true] { background: color-mix(in srgb, var(--primary) 14%, transparent); color: var(--fg); font-weight: 600; }\n  .card { background: var(--card); border: 1px solid var(--line); border-radius: var(--r); padding: 1rem; }\n  .card.on { border-color: var(--primary); }\n  .card.later { opacity: .6; }\n  .card h2 { margin: 0 0 .2rem; font-size: .75rem; letter-spacing: .07em; text-transform: uppercase; color: var(--muted); }\n  .card b { font-size: 1.1rem; }\n  ol { list-style: none; counter-reset: s; margin: .9rem 0 0; padding: 0; }\n  ol li { counter-increment: s; position: relative; padding: 0 0 .9rem 2.6rem; }\n  ol li::before { content: counter(s); position: absolute; left: 0; top: 0; width: 1.8rem; height: 1.8rem; border-radius: 50%;\n                  display: grid; place-items: center; background: color-mix(in srgb, var(--primary) 14%, transparent); font-weight: 700; }\n  ol li b { display: block; font-size: 1rem; }\n  .grow { flex: 1; }\n  a.btn { display: block; text-align: center; font-weight: 700; font-size: 1.1rem; padding: 1rem; border-radius: var(--r);\n          background: var(--primary); color: var(--primary-fg); text-decoration: none; }\n  a.alt { background: var(--card); color: var(--fg); border: 1px solid var(--line); }\n  [hidden] { display: none !important; }\n</style></head><body><main>\n<header>\n  <img src=\"/crew-join/mark.svg\" alt=\"\" onerror=\"this.remove()\">\n  <h1>Join Relay crew</h1>\n  <p>The plan, your checklist, team chat and intercom on your phone. This page only works on the church Wi-Fi.</p>\n</header>\n<div class=\"seg\" role=\"group\" aria-label=\"Your phone\">\n  <button type=\"button\" data-os=\"ios\" aria-pressed=\"true\">iPhone or iPad</button>\n  <button type=\"button\" data-os=\"android\" aria-pressed=\"false\">Android</button>\n</div>\n\n<section class=\"card on\">\n  <h2>Step 1 of 2</h2>\n  <b>Relay has no certificate yet</b>\n  <p>Ask whoever runs the booth to open Relay once, then scan again.</p>\n</section>\n\n<section class=\"card later\">\n  <h2>Step 2 of 2</h2>\n  <b>Open the crew page and add it to your Home Screen</b>\n  \n  <p>If the phone still warns you, tap Advanced and continue. The page works, but it will not install to the Home\n    Screen until the certificate is trusted.</p>\n  \n</section>\n<div class=\"grow\"></div>\n\n<a class=\"btn alt\" href=\"https://192.168.1.5:8001/crew\">Open Relay crew</a>\n</main>\n<script>\n  (function () {                       // pick the phone's own steps; the buttons switch them\n    var android = /Android/i.test(navigator.userAgent);\n    function show(os) {\n      document.querySelectorAll('[data-os]').forEach(function (b) { b.setAttribute('aria-pressed', String(b.dataset.os === os)); });\n      document.querySelectorAll('[data-for]').forEach(function (l) { l.hidden = l.dataset.for !== os; });\n    }\n    document.querySelectorAll('[data-os]').forEach(function (b) { b.addEventListener('click', function () { show(b.dataset.os); }); });\n    show(android ? 'android' : 'ios');\n  })();\n</script>\n</body></html>"
}