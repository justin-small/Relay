 "html": "<!doctype html>\n<html lang=\"en\"><head>\n<meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<title>Relay &middot; Flash a panel</title><link rel=\"icon\" href=\"/static/brand/favicon.ico\" sizes=\"32x32\"><link rel=\"icon\" href=\"/static/brand/favicon.svg\" type=\"image/svg+xml\"><link rel=\"apple-touch-icon\" href=\"/static/brand/apple-touch-icon.png\"><link rel=\"manifest\" href=\"/static/brand/site.webmanifest\"><link rel=\"stylesheet\" href=\"/static/viewer.css?v=18eabefb1d726926\"><link rel=\"stylesheet\" href=\"/static/tokens.css?v=18eabefb1d3bf1bf\"><link rel=\"stylesheet\" href=\"/static/components.css?v=18eabefb212bd886\"><script src=\"/static/look.js?v=18eabefb21aa1849\"></script>\n<script type=\"module\" src=\"/static/flasher.js?v=18eabefb2146cad2\"></script>\n\n<style>\n  /* Layout only (#463): the controls come from components.css, the sizes and colours from tokens.css. */\n  body { display:block; margin:0; font:var(--fs-base)/1.45 var(--font); background:var(--bg); color:var(--fg); }\n  .wrap { max-width:760px; margin:0 auto; padding:22px 20px 90px; }\n  header { display:flex; align-items:center; gap:12px; margin-bottom:20px; }\n  header h1 { font-size:var(--fs-xl); margin:0; font-weight:600; }\n  header .spacer { flex:1; }\n  a { color:inherit; }\n  h2.title { font-size:var(--fs-2xl); margin:0 0 6px; font-weight:600; }\n  .sub { color:var(--muted); margin:0 0 18px; line-height:1.5; }\n  section { border:1px solid var(--border); border-radius:var(--r); background:var(--card); padding:16px 18px; margin-bottom:14px; }\n  section h3 { font-size:var(--fs-lg); font-weight:600; margin:0 0 12px; display:flex; align-items:center; gap:9px; }\n  .num { display:inline-grid; place-items:center; width:22px; height:22px; border-radius:50%;\n         background:var(--inset); border:1px solid var(--border); font-size:var(--fs-sm); }\n  code { font-size:var(--fs-md); }\n  ol.list { margin:0; padding-inline-start:1.25rem; display:grid; gap:6px; line-height:1.5; }\n  .stack > * + * { margin-top:12px; }\n  .row { align-items:center; }\n  .row > * { flex:0 1 auto; }\n  .row[hidden] { display:none; }\n  input[type=file] { width:auto; color:var(--fg); border:0; background:none; }\n  .boards { display:flex; gap:10px; flex-wrap:wrap; list-style:none; margin:0; padding:0; }\n  .boards a { display:block; padding:10px 14px; border:1px solid var(--border); border-radius:var(--r-ctl); text-decoration:none; }\n  .boards a[aria-current] { border-color:var(--primary); }\n  .boards small { display:block; color:var(--muted); margin-top:2px; }\n  .notice { margin:0; line-height:1.5; background:none; }\n  .notice.error { border-color:var(--err); color:var(--err); }\n  .notice:focus { outline:none; }\n  .flash-steps { margin:0; padding-inline-start:1.25rem; display:grid; gap:6px; color:var(--muted); }\n  .flash-steps[hidden] { display:none; }\n  .flash-steps .on { color:var(--fg); font-weight:600; }\n  .flash-steps .on::marker { color:var(--primary); }\n  .flash-progress { width:100%; accent-color:var(--primary); }\n</style>\n</head><body>\n<div class=\"wrap\">\n<header>\n  <h1 class=\"brand\"><svg class=\"lockup\" role=\"img\" aria-label=\"Relay\" xmlns=\"http://www.w3.org/2000/svg\" width=\"82\" height=\"24\" viewBox=\"0 0 219.3 64\"><g transform=\"translate(-15.3 -14.55) scale(1.4545)\"><rect x=\"11.5\" y=\"14\" width=\"9\" height=\"36.4\" rx=\"4.5\" fill=\"currentColor\"/><path fill-rule=\"evenodd\" fill=\"var(--brand,#4ade80)\" d=\"M33.5 14H44.5A9 9 0 0 1 53.5 23V30A9 9 0 0 1 49 37.8L52.6 48.2Q53.6 51.4 50.4 50.2L37 39H33.5A9 9 0 0 1 24.5 30V23A9 9 0 0 1 33.5 14ZM32.5 20.8H45.5A2 2 0 0 1 47.5 22.8V22.8A2 2 0 0 1 45.5 24.8H32.5A2 2 0 0 1 30.5 22.8V22.8A2 2 0 0 1 32.5 20.8ZM32.5 28.3H39.0A2 2 0 0 1 41.0 30.3V30.299999999999997A2 2 0 0 1 39.0 32.3H32.5A2 2 0 0 1 30.5 30.299999999999997V30.3A2 2 0 0 1 32.5 28.3Z\"/></g><path transform=\"translate(84.29 19.6) scale(0.62)\" d=\"M0 40V0M0 18A18 18 0 0 1 18 0M33 20H73A20 20 0 1 0 67.14 34.14M92 -24V40M151 20A20 20 0 1 0 151 20.01M151 0V40M170 0V20A20 20 0 0 0 210 20M210 0V44A16 16 0 0 1 194 60H186\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"9\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg></h1>\n  <span class=\"spacer\"></span>\n  <a href=\"/admin#panels\">Back to Panels</a>\n</header>\n\n<h2 class=\"title\">Flash a panel</h2>\n<p class=\"sub\">Write a new or recovered panel&rsquo;s firmware over USB. A panel keeps its Wi-Fi and its settings.</p>\n\n\n\n<section aria-labelledby=\"image-title\">\n  <h3 id=\"image-title\"><span class=\"num\" aria-hidden=\"true\">1</span>The firmware</h3>\n  <div class=\"stack\" data-flash-upload data-board=\"crowpanel-adv7\">\n    \n    <p>No USB image for the CrowPanel Advance 7&#34; is on this Relay yet.</p>\n    \n    <p class=\"muted\">Upload <span class=\"mono\">relay-display.bin</span> from a release: the whole image, bootloader\n      included. The <span class=\"mono\">relay-display-app.bin</span> uploaded under Panels updates a running panel and\n      cannot start a blank one.</p>\n    <div class=\"row\">\n      <input type=\"file\" accept=\".bin,application/octet-stream\" aria-label=\"relay-display.bin\" data-upload-file>\n      <button type=\"button\" data-upload>Upload</button>\n      \n    </div>\n    <p class=\"notice error\" data-upload-error role=\"alert\" hidden></p>\n  </div>\n</section>\n\n\n</div>\n</body></html>"
}