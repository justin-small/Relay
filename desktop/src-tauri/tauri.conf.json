{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Relay",
  "version": "0.1.0",
  "identifier": "app.relay.desktop",
  "build": { "frontendDist": "../dist" },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Relay",
        "url": "index.html",
        "width": 1280,
        "height": 860,
        "minWidth": 800,
        "minHeight": 560,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDcwRUM5MTcwNUIzQURDRjUKUldUMTNEcGJjSkhzY0Z3cXo2dWE1YzY2SGF1ZDNWWEJmWkFkUHlsa3NXWUUrN0pQNUc1SUN6WkMK",
      "endpoints": ["https://relaychurchsystems.com/updates/latest.json"],
      "windows": { "installMode": "passive" }
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": false,
    "targets": ["app", "dmg", "nsis", "appimage", "deb"],
    "category": "Productivity",
    "shortDescription": "Live captions and translation",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": { "relay-backend/": "relay-backend/" },
    "macOS": {
      "minimumSystemVersion": "11.0",
      "entitlements": "Entitlements.plist",
      "infoPlist": "Info.plist"
    },
    "windows": {
      "webviewInstallMode": { "type": "embedBootstrapper" },
      "nsis": { "installMode": "currentUser" }
    },
    "linux": {
      "deb": { "depends": ["libportaudio2"] },
      "appimage": { "bundleMediaFramework": false }
    }
  }
}
