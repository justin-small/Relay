# Secrets and generated state — the OpenAI API key, the admin token, and the
# operator panel's TLS key. Never commit.
config.json
# Recorded runs: every word spoken at an event. Never commit.
recordings/

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/

# OS
.DS_Store
Thumbs.db

# Local agent / editor tooling — kept on disk, not shared.
.claude/
.codex/
.agents/
.mcp.json
.ignore
/graft/

# The signed panel firmware an operator uploaded to this Relay (app/panelfw.py).
panel-firmware/

# Planning Center live-test credentials (tools/check_planningcenter.py)
planningcenter-test.env

# Local Docker-era runtime config (certs, config, panel firmware). Never commit.
docker-config/

# Test runs (tests/run_all.py --coverage, --junit)
.coverage
.coverage.*
htmlcov/
test-results.xml


# UniFi live-test credentials (tools/check_unifi.py)
unifi-test.env

# UI audit findings, screenshots and demo harness (local only)
docs/ui-audit/*
# The shared-style exceptions (#463) are committed; the rest of the audit stays local.
!docs/ui-audit/standardization-spec.md

# Mixing console snapshots and site mockups (local only)
board configs/
site/mockups/

# Rust audio-bus spike build output
native/mutants.out*/
target/
# Local Rust tooling output (cargo-fuzz, cargo-llvm-cov, cargo-flamegraph); fuzz/Cargo.lock is not committed
native/relay-server/fuzz/corpus/
native/relay-server/fuzz/artifacts/
native/relay-server/fuzz/Cargo.lock
native/llvm-cov-target/
native/lcov.info
flamegraph.svg
perf.data*
native/relay-bus/.venv-build/
native/relay-ndi/.venv-build/

# Output of tools/stress.py
stress-results/

# iOS app (ios/): build output and UI test recordings are large and rebuilt on demand
ios/**/build/
ios/**/ui-test-results/
ios/**/DerivedData/
ios/**/.build/
ios/**/.swiftpm/
ios/**/xcuserdata/
