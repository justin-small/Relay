# The production build of the Relay panel, the part every board shares. `sdkconfig` itself is
# generated and ignored; this file is the part that is a decision.
#
# **Half of the decision.** The chip, the module's flash and PSRAM, and the panel's own settings are the
# board's, in `sdkconfig.board.<name>`, and `build.sh --board <name>` applies that file and then this one
# (and then `sdkconfig.dev` or `sdkconfig.qemu`). The two halves set different options, so the order between
# them does not matter; the board's is first because ESP-IDF reads the chip from the first file that names it.

# `partitions.csv`, with `nvs` above the application slots. The reasoning is in
# that file.
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# The console's line endings. Which port the console is on is the board's.
CONFIG_NEWLIB_STDOUT_LINE_ENDING_LF=y

# Out of scope on every board: no Bluetooth, no Ethernet and no SD
# card. Each is off here so no driver for it compiles into the image.
CONFIG_BT_ENABLED=n

# Ethernet is off through the driver choices. `CONFIG_ETH_ENABLED` is an umbrella
# that is not a prompt, and the SPI and OpenETH drivers each select it on by
# default, so setting the umbrella alone does nothing. A chip with an internal
# EMAC turns that one off in its board file. Found when the build still
# compiled `esp_eth`.
CONFIG_ETH_USE_SPI_ETHERNET=n
CONFIG_ETH_USE_OPENETH=n

# Wi-Fi is the only network interface. Provisioning arrives on it later.
CONFIG_ESP_WIFI_ENABLED=y

# **The network stays on core 0; core 1 is the panel's.** `main.cpp` sets the panel up from core 1 so its
# interrupt, which refills the bounce buffer, lands there. A critical section masks interrupts on its own core
# only, and the bench showed one on the panel's core is a flicker: a FreeRTOS task snapshot flickered the picture
# from core 1 and not from core 0. Wi-Fi's task is on core 0 by default. lwIP's has no affinity by default, and
# under a UDP flood it ran about a quarter of the CPU and flickered the panel from core 1 now and then.
CONFIG_LWIP_TCPIP_TASK_AFFINITY_CPU0=y

# **Eight received frames in flight, not thirty-two.** Each dynamic Wi-Fi receive buffer is a frame in
# internal RAM, and the panel's bounce buffers and every DMA allocation live in that RAM too. A 60-second UDP flood
# on the bench took free internal RAM from about 49 KB down to 1.8 KB with 32 buffers, and again with 16; with 8 its
# low point was 14.7 KB and no allocation failed. A room display receives a server-sent event stream and the odd
# page, not bulk data, so the cost is throughput nothing here needs: a flood drops frames at the radio. lwIP's input
# queue is cut to match, since a queue deeper than the buffers behind it only holds frames longer.
# `SPIRAM_TRY_ALLOCATE_WIFI_LWIP` would move the buffers to PSRAM instead, and was not taken: it puts the radio's
# traffic on the bus the panel reads its frame over, which is how the panel shifted sideways in the first place.
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=8
CONFIG_LWIP_TCPIP_RECVMBOX_SIZE=16

# Size first. The display's rendering is one pass per strip and does not need
# speed; a smaller image is the cheaper thing to hold over a slow link.
CONFIG_COMPILER_OPTIMIZATION_SIZE=y
CONFIG_LOG_DEFAULT_LEVEL_INFO=y

# ---------------------------------------------------------------------------
# Updating the board over the network. Set now so the image that ships
# first has the same rules as the one that does not yet update.
# ---------------------------------------------------------------------------

# A freshly written image boots on approval and has to say so; without rollback
# a bad update is a site visit with a serial cable.
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# Secure Boot V2 with no hardware secure boot: the running application carries the
# public key, and `esp_ota_end` checks the next image against it. The consequence: an
# unsigned image refuses every update, so boards on an unsigned build are flashed over USB.
# The update itself is a later change; the signing is set up here so the first image in the
# field can already take it.
CONFIG_SECURE_SIGNED_APPS_NO_SECURE_BOOT=y
CONFIG_SECURE_SIGNED_ON_UPDATE_NO_SECURE_BOOT=y

# The build does not hold the private key. `build.sh --sign` does the signing,
# outside the build, so a laptop build needs no secret to compile.
CONFIG_SECURE_BOOT_BUILD_SIGNED_BINARIES=n

# LVGL takes its settings from Kconfig here. The setup screen's QR code, which a phone's camera joins the setup
# network from, and the three font sizes the text screens use. The QR code draws on a canvas, which the
# component's defaults already enable.
# LVGL's bundled examples are not used; building them is most of the build's objects.
CONFIG_LV_BUILD_EXAMPLES=n
CONFIG_LV_USE_QRCODE=y
CONFIG_LV_FONT_MONTSERRAT_14=y
CONFIG_LV_FONT_MONTSERRAT_16=y
CONFIG_LV_FONT_MONTSERRAT_18=y
CONFIG_LV_FONT_MONTSERRAT_22=y
CONFIG_LV_FONT_MONTSERRAT_26=y
CONFIG_LV_FONT_MONTSERRAT_30=y

# **LVGL allocates from the heap, not from a 64 KB pool of its own.** The caption view holds a label for each of up to
# 200 lines, about 300 bytes apiece with its text, which is most of that pool and would leave the setup screen's QR
# code no room. The heap is shared, and what the lines cost shows in the `heap:` log line.
# CONFIG_LV_USE_BUILTIN_MALLOC is not set
CONFIG_LV_USE_CLIB_MALLOC=y

# **Sixteen sockets, not ESP-IDF's ten.** The setup page's server holds its listening socket, a control socket
# and up to seven connections, the setup network's DNS holds one, and the caption
# stream's connection holds one. An iPhone's captive-portal sheet and Safari open five or six
# connections at once, and with ten the server's accept failed with ENFILE on the bench (2026-10-28). Each
# socket is a table entry; the memory that matters is per connection, which the server's own limit still bounds.
CONFIG_LWIP_MAX_SOCKETS=16

# **The main task has 8 KB of stack, not ESP-IDF's 3.5.** `app_main` opens the setup network on a first boot, and
# that draws the setup screen from this task: the lines, their copies of the names and passphrase, and the QR
# code's text. Adding the QR code's 160 bytes overflowed the default on the bench (2026-10-28), a reboot on the
# first boot after a flash. `app_main` returns once the boot is done, and its stack is freed with it.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192

# The system event task runs the Wi-Fi and address callbacks, and the setup page's save runs from one of them
# (`provision.cpp`, `attempt_succeeded`): loading and saving the settings blob there overflowed the default 2304 bytes
# and restarted the panel before a new network was saved.
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=4096
